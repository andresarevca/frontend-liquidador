# ---------------------------------------------------------------------------
# frontend-liquidador — variables de entorno
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env al control de versiones.
# ---------------------------------------------------------------------------

# URL base del backend (backend-liquidador).
# Actualmente el cliente API (src/api/client.ts) usa rutas relativas "/api/..."
# y en desarrollo Vite las redirige mediante el proxy fijo definido en
# vite.config.ts ("http://localhost:8000"). Esta variable queda documentada
# para cuando se desacople esa URL del código (build de producción, otros
# entornos, etc.).
VITE_API_BASE_URL=http://localhost:8000
